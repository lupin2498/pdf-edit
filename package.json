{
  "name": "pdf-edit",
  "productName": "PDF Edit",
  "version": "1.0.0",
  "description": "PDF Edit - trình chỉnh sửa PDF cho Windows (chỉnh sửa nội dung, chú thích, quản lý trang, gộp file)",
  "main": "src/main/main.js",
  "author": "lupin2498",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "npm run build:renderer && electron .",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "npm run build:renderer && node --test --test-concurrency=1 \"tests/e2e/**/*.test.mjs\"",
    "dist:win": "npm run build:renderer && electron-builder --win --x64",
    "dist:dir": "npm run build:renderer && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.17.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0"
  },
  "build": {
    "appId": "com.lupin2498.pdfedit",
    "productName": "PDF Edit",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
